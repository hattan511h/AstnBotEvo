DISCORD_TOKEN=
OPENROUTER_API_KEY=

# اختياري: البوت يدخل الروم تلقائياً ويرجع يدخله لو انقطع
GUILD_ID=
VOICE_CHANNEL_ID=

# مودل مجاني يقبل صوت ويرد نص
MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# الرد الصوتي (TTS مجاني). حط false لو تبي بدون رد صوتي
VOICE_REPLIES=true
TTS_MODEL=fish-audio/s2.1-pro-free
# اختياري: معرّف صوت من Fish Audio
TTS_VOICE=

# الكلمات اللي ينادونه فيها
WAKE_WORDS=بوت, يا بوت, bot, hey bot

# لو yt-dlp مو في PATH حط المسار الكامل
YTDLP_PATH=yt-dlp

# yt-dlp يحتاج JS runtime ليوتيوب. Node موجود عندك فخليه node (فاضي = تعطيل)
YTDLP_JS_RUNTIME=node
# اختياري: لو يوتيوب قال "Sign in to confirm you're not a bot" على السيرفر
# حط محتوى ملف cookies.txt (Netscape) بعد تحويله base64
YT_COOKIES_B64=
